{
  "name": "tubeclickpro-backend-engine",
  "version": "0.3.1",
  "private": true,
  "description": "Dedicated heavy-processing engine for TubeClick Pro Clone & Crush AI",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:mcp": "tsx watch src/mcp/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:mcp": "node dist/mcp/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supabase/supabase-js": "2.112.3",
    "bullmq": "6.1.2",
    "dotenv": "17.4.2",
    "fastify": "5.12.0",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
