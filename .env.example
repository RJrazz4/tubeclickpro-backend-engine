NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=tubeclickpro
JOB_RESULT_TTL_SECONDS=86400

# Server-authoritative auth and subscription lookup
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The current TubeClick frontend entitlement authority is get_ghost_tier_for.
SUPABASE_TIER_SOURCE=rpc
SUPABASE_TIER_RPC=get_ghost_tier_for
# Used only when SUPABASE_TIER_SOURCE=subscriptions.
SUPABASE_SUBSCRIPTIONS_TABLE=subscriptions

# Queue isolation and resource policy
WORKER_TIER=all
FREE_WORKER_CONCURRENCY=2
PREMIUM_WORKER_CONCURRENCY=10
FREE_QUEUE_RATE_MAX=2
FREE_QUEUE_RATE_DURATION_MS=10000
PREMIUM_QUEUE_RATE_MAX=20
PREMIUM_QUEUE_RATE_DURATION_MS=1000
FREE_JOBS_PER_DAY=1
PREMIUM_JOBS_PER_HOUR=20
FREE_MAX_ACTIVE_JOBS=1
PREMIUM_MAX_ACTIVE_JOBS=5

# Python / Agent-Reach capability worker
PYTHON_BIN=python3
AGENT_REACH_WORKER_PATH=workers/python/viral_dna_worker.py
SCRAPER_TIMEOUT_MS=90000

# Official backup engine. Store the real key only in deployment secrets.
YOUTUBE_API_KEY=
YOUTUBE_API_TIMEOUT_MS=10000

# Neural VoiceRouter. Provider-specific voice IDs stay server-side.
VOICE_MAX_CHARACTERS=5000
VOICE_GENERATIONS_PER_HOUR=20
VOICE_PROVIDER_TIMEOUT_MS=60000
VOICE_IDEMPOTENCY_TTL_SECONDS=3600
VOICE_MAX_AUDIO_BYTES=52428800
VOICE_IDEMPOTENCY_CACHE_MAX_BYTES=10485760
FFMPEG_BIN=ffmpeg

# High-tier providers (attempted first). Comma-separated authorized keys.
ELEVENLABS_API_KEY=your_elevenlabs_key_1,your_elevenlabs_key_2
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_MAP_JSON={}
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_MODEL_ID=s2.1-pro
FISH_AUDIO_VOICE_MAP_JSON={}

# Open-source fallbacks (attempted in this order)
# GPT_SOVITS_URL should be the full API v2 /tts endpoint.
GPT_SOVITS_URL=
GPT_SOVITS_API_KEY=
GPT_SOVITS_VOICE_MAP_JSON={}
# Piper maps a TubeClick alias to an on-disk .onnx model path.
PIPER_BIN=
PIPER_VOICE_MAP_JSON={}
# ChatTTS points to a private adapter that accepts {text,speaker,speed,format}.
CHATTTS_URL=
CHATTTS_API_KEY=
CHATTTS_VOICE_MAP_JSON={}

# MCP context bridge. In production this points at the compiled local server.
MCP_CONTEXT_ENABLED=true
MCP_CONTEXT_COMMAND=node
MCP_CONTEXT_ARGS=dist/mcp/server.js
MCP_TOOL_TIMEOUT_MS=10000

# Development auth is rejected when NODE_ENV=production.
# Local requests use x-dev-user-id and x-dev-tier headers only in development.
